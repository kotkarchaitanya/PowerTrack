{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "home.html",
      "use": "@vercel/static"
    },
    {
      "src": "history.html",
      "use": "@vercel/static"
    },
    {
      "src": "schedule.html",
      "use": "@vercel/static"
    },
    {
      "src": "notices.html",
      "use": "@vercel/static"
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "js/**",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "data.json",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/css/(.*)", "dest": "/css/$1" },
    { "src": "/js/(.*)", "dest": "/js/$1" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/data.json", "dest": "/data.json" },
    { "src": "/home.html", "dest": "/home.html" },
    { "src": "/history.html", "dest": "/history.html" },
    { "src": "/schedule.html", "dest": "/schedule.html" },
    { "src": "/notices.html", "dest": "/notices.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
